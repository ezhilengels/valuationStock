# ── SIMULATION MODE ───────────────────────────────────────────
# Set SIMULATION_MODE=true to test the bot against a past date.
# Set SIMULATION_MODE=false (or leave blank) for leave/current data.
SIMULATION_MODE=true

# The year and month to simulate (only used when SIMULATION_MODE=true)
SIMULATED_YEAR=2024
SIMULATED_MONTH=12

# ── R&D MODE ──────────────────────────────────────────────────
# Set to true to show Buffett Yield for all companies (including Banks/PSUs)
ENABLE_BUFFET_YIELD_FOR_ALL=true
